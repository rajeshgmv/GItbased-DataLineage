      "qualified_name": "Users-guttikonda-gitbased-DataLineage-GItbased-DataLineage-repo_local_clone-json_reader_test.src.json_to_csv",
      "evidence_type": "source",
      "excerpt": "INPUT_JSON_PATH = Path(\n    \"/Users/guttikonda/Desktop/training docs/chroma_db_reader/chroma-export.json\"\n)\nOUTPUT_CSV_PATH = Path(\n    \"/Users/guttikonda/Desktop/training docs/json_reader/output/btc_prices.csv\"\n)\n...\ndef extract_btc_rows(records: Iterable[Any]) -> Iterator[tuple[Any, str]]:\n    \"\"\"Yield (metadata timestamp, document price) for every BTC record.\"\"\"\n    for index, record in enumerate(records):\n        if not isinstance(record, dict):\n            raise ValueError(f\"Record {index} is not a JSON object\")\n\n        metadata = record.get(\"metadata\")\n        if not isinstance(metadata, dict):\n            raise ValueError(f\"Record {index} has no valid metadata object\")\n\n        if str(metadata.get(\"asset\", \"\")).upper() != \"BTC\":\n            continue\n\n        timestamp = metadata.get(\"time\")\n        if timestamp is None:\n            raise ValueError(f\"BTC record {index} has no metadata.time value\")\n\n        document = record.get(\"document\")\n        if not isinstance(document, str):\n            raise ValueError(f\"BTC record {index} has no valid document string\")\n\n        price_match = PRICE_PATTERN.search(document)\n        if price_match is None:\n            raise ValueError(f\"Could not find the BTC price in record {index}\")\n\n        yield timestamp, price_match.group(1)\n\n\ndef convert_json_to_csv(input_path: Path, output_path: Path) -> int:\n    \"\"\"Convert a JSON array of Chroma records and return the rows written.\"\"\"\n    with input_path.open(encoding=\"utf-8\") as input_file:\n        records = json.load(input_file)\n\n    if not isinstance(records, list):\n        raise ValueError(\"The input JSON must contain an array of records\")\n\n    rows = list(extract_btc_rows(records))\n    output_path.parent.mkdir(parents=True, exist_ok=True)\n\n    with output_path.open(\"w\", encoding=\"utf-8\", newline=\"\") as output_file:\n        writer = csv.writer(output_file)\n        writer.writerow((\"timestamp\", \"btc_price\"))\n        writer.writerows(rows)\n\n    return len(rows)\n\n\ndef main() -> int:\n    try:\n        row_count = convert_json_to_csv(INPUT_JSON_PATH, OUTPUT_CSV_PATH)\n    except (OSError, json.JSONDecodeError, ValueError) as error:\n        print(f\"Error: {error}\", file=sys.stderr)\n        return 1\n\n    print(f\"Wrote {row_count} BTC rows to {OUTPUT_CSV_PATH}\")\n    return 0"
    },
