      "qualified_name": "Users-guttikonda-gitbased-DataLineage-GItbased-DataLineage-repo_local_clone-Chroma_db_reader.src.main.java.com.example.chromareader.ChromaDbExporter",
      "evidence_type": "source",
      "excerpt": "    private static final String CHROMA_DB_DIRECTORY =\n            \"/Users/guttikonda/Desktop/training docs/crypto-kafka-rag-project/crypto_chroma_db\";\n    private static final String OUTPUT_JSON_FILE = \"chroma-export.json\";\n\n    private static final String EXPORT_SQL = \"\"\"\n            WITH records AS (\n                SELECT\n                    c.name AS collection_name,\n                    e.id AS row_id,\n                    e.embedding_id,\n                    MAX(CASE\n                        WHEN em.key = 'chroma:document' THEN em.string_value\n                    END) AS document,\n                    json_group_object(\n                        em.key,\n                        CASE\n                            WHEN em.string_value IS NOT NULL THEN em.string_value\n                            WHEN em.int_value IS NOT NULL THEN em.int_value\n                            WHEN em.float_value IS NOT NULL THEN em.float_value\n                            WHEN em.bool_value IS NOT NULL THEN json(\n                                CASE WHEN em.bool_value = 1 THEN 'true' ELSE 'false' END\n                            )\n                            ELSE NULL\n                        END\n                    ) FILTER (WHERE em.key NOT LIKE 'chroma:%') AS metadata\n                FROM collections c\n                JOIN segments s\n                    ON s.collection = c.id\n                   AND s.scope = 'METADATA'\n                JOIN embeddings e ON e.segment_id = s.id\n                LEFT JOIN embedding_metadata em ON em.id = e.id\n                GROUP BY c.name, e.id, e.embedding_id\n            )\n            SELECT json_group_array(\n                json_object(\n                    'collection', collection_name,\n                    'id', embedding_id,\n                    'document', document,\n                    'metadata', json(COALESCE(metadata, '{}'))\n                )\n            )\n            FROM (\n                SELECT * FROM records ORDER BY collection_name, row_id\n            );\n            \"\"\";\n\n    private ChromaDbExporter() {\n    }\n\n    public static void main(String[] args) throws Exception {\n        Path input = Path.of(CHROMA_DB_DIRECTORY).toAbsolutePath().normalize();\n        Path database = Files.isDirectory(input) ? input.resolve(\"chroma.sqlite3\") : input;\n        Path output = Path.of(OUTPUT_JSON_FILE).toAbsolutePath().normalize();\n\n        if (!Files.isRegularFile(database)) {\n            throw new IllegalArgumentException(\"Chroma database not found: \" + database);\n        }\n\n        Path outputParent = output.getParent();\n        if (outputParent != null) {\n            Files.createDirectories(outputParent);\n        }\n\n        export(database, output);\n        System.out.println(\"Export complete: \" + output);"
    }
  ]
